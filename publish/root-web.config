<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
    <!-- Roteamento de SPA: uma rota como /inauguracoes não existe em disco, e o
         404 do IIS é substituído pelo index.html para o React assumir. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>

  <!-- EXCEÇÃO PARA OS ARQUIVOS DO BUILD — não remova sem ler.

       A regra acima devolve o index.html com status 200 para QUALQUER caminho
       inexistente, inclusive um .js. Em 03/08/2026 isso derrubou o Hub: durante
       o upload do deploy, chunks que ainda não tinham chegado foram pedidos e
       receberam esse HTML com 200. O Cloudflare, que fica na frente do domínio,
       tratou 200 como resposta válida e guardou o HTML no lugar do JavaScript
       por 4 horas (max-age=14400). O navegador recusa por MIME type e a tela
       fica branca — e não havia como purgar o cache.

       Aqui o fallback é desligado para /app/: arquivo que não existe volta como
       404 de verdade. O Cloudflare não cacheia 404 dessa forma, então um deploy
       incompleto vira um erro isolado e temporário em vez de site fora do ar.

       PassThrough = "deixe a resposta original passar", ou seja, o 404 do IIS.
       Só afeta o caminho de arquivo inexistente; arquivo que existe continua
       sendo servido normalmente. -->
  <location path="app">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>

  <!-- Mesma proteção para o caminho antigo, ainda presente no servidor. -->
  <location path="assets">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
